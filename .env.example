# LLM Provider API Keys
MISTRAL_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
OPENAI_API_KEY=

# LangSmith Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=cbse-notes-ai

# Model Router Overrides (optional - override per-node model assignments)
# Format: NODE_NAME__PROVIDER=provider_name
#         NODE_NAME__MODEL=model_name
# Example:
# PLANNER__PROVIDER=mistral
# PLANNER__MODEL=mistral-medium
# SYNTHESIZER__PROVIDER=google
# SYNTHESIZER__MODEL=gemini-2.0-flash

# Application Settings
LOG_LEVEL=INFO
MAX_RETRIES=2
CACHE_TTL_HOURS=168
